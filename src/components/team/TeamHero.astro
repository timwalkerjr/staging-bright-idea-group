---
---

<section id="team-hero" class="relative bg-dark-background overflow-hidden">
  <video
    autoplay
    muted
    loop
    playsinline
    poster="/assets/images/hero-poster.webp"
    class="absolute inset-0 w-full h-full object-cover z-0"
  >
    <source
      src="/assets/video/hero-lightbulbs.mp4"
      type="video/mp4"
    />
  </video>
  <div class="absolute inset-0 z-[1]" style="background: linear-gradient(rgba(0, 19, 53, 0.75), rgba(0, 19, 53, 0.75));"></div>
  <div class="flex flex-col justify-center items-start min-h-[420px] max-w-[1440px] mx-auto px-6 py-20 md:py-24 relative z-10">
    <a href="/" class="block mb-10" aria-label="Bright Idea Group Home">
      <img
        src="/assets/images/logo-light.webp"
        alt="Bright Idea Group"
        class="h-[48px] w-auto"
        loading="eager" />
    </a>
    <h1 class="text-[44px] leading-[61.6px] font-bold font-serif text-white mb-6">
      We're Business Owners too!
    </h1>
    <p class="text-[18px] leading-[28.8px] font-normal font-sans text-white/90 max-w-[800px]">
      Our leadership team is made up of <strong class="font-medium">agency owners with more than 20 years experience each</strong>. Each member of Bright Idea Group is an expert in their individual service areas and has been vetted extensively before joining our group.
    </p>
  </div>
</section>
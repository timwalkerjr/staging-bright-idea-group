<section class="bg-[rgba(201,210,217,0.45)] pb-20">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-[1440px] mx-auto px-6">
    {services.map((service) => (
      <div class="bg-white grid grid-cols-1 sm:grid-cols-2 rounded-none overflow-hidden shadow-sm group">
        <div class="relative h-[220px] sm:h-auto min-h-[200px]">
          <img src={service.image} alt={service.title} class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="p-6 sm:p-7 flex flex-col justify-between">
          <div>
            <h3 class="text-[24px] leading-[33.6px] font-bold font-serif text-[rgb(34,34,34)] mb-3">{service.title}</h3>
            <p class="text-[16px] leading-[26px] text-[rgb(34,34,34)] mb-4">{service.excerpt}</p>
          </div>
          <div class="text-right">
            <a href={service.link} class="text-[rgb(34,66,125)] font-normal text-[16px] hover:underline">Learn more</a>
          </div>
        </div>
      </div>
    ))}

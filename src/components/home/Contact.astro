---
// Contact Section matching brightideagroup.com
---

<section id="contact" class="bg-[#c9d2d9]/45 py-20" data-ps="src/components/home/Contact.astro:section">
  <div class="max-w-[1440px] mx-auto px-6" data-ps="src/components/home/Contact.astro:container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20" data-ps="src/components/home/Contact.astro:grid">
      <!-- Left Column: Info & Details -->
      <div data-ps="src/components/home/Contact.astro:left-col">
        <h2 class="leading-[1.3] font-bold font-serif mb-4 text-[rgb(34,34,34)] text-[36px]" data-ps="src/components/home/Contact.astro:title">
          Contact us
        </h2>
        <p class="text-[18px] leading-[28.8px] text-[#222222] mb-8" data-ps="src/components/home/Contact.astro:desc">
          We are available most days during normal business hours to consult with you and determine how we might best help your firm. Reach out to us using the form or the contact information below.
        </p>

        <div class="flex flex-col gap-4 text-[18px] text-[#222222]" data-ps="src/components/home/Contact.astro:contact-list">
          <!-- Email -->
          <div class="flex items-center gap-3" data-ps="src/components/home/Contact.astro:item-email">
            <div class="w-6 h-6 text-[#22427D] shrink-0" data-ps="src/components/home/Contact.astro:icon-email">
              <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                <path d="M3.05359 5.74219V18.9463H20.9462V6.13867L20.1708 6.64844L12.2147 11.8867C12.1544 11.9184 12.102 11.944 12.0565 11.9619C12.0534 11.9629 12.0366 11.9678 11.9999 11.9678C11.9626 11.9678 11.946 11.9628 11.9432 11.9619C11.8975 11.9439 11.8448 11.9186 11.7841 11.8867L4.05359 6.7959V6.39648L11.7264 11.4219L11.9999 11.6016L12.2733 11.4229L20.62 5.97266L21.6307 5.31152C21.6464 5.38933 21.6551 5.46973 21.6552 5.55371V18.4463C21.6552 18.7675 21.5429 19.041 21.2938 19.2891C21.0449 19.5371 20.7701 19.6494 20.4462 19.6494H3.55359C3.23187 19.6494 2.95869 19.5371 2.71082 19.2891L2.6239 19.1953C2.43623 18.9725 2.35046 18.7279 2.35046 18.4463V5.55371C2.35048 5.46519 2.35953 5.38047 2.37683 5.29883L3.05359 5.74219ZM3.55359 4.34473H20.4462C20.7696 4.34473 21.0438 4.4579 21.2928 4.70703H21.2938C21.4035 4.81669 21.485 4.93216 21.5438 5.05371H2.46082C2.5195 4.93172 2.60127 4.81595 2.71082 4.70605H2.71179C2.95976 4.45718 3.23251 4.34476 3.55359 4.34473Z" fill="currentColor" stroke="currentColor"></path>
              </svg>
            </div>
            <a href="mailto:shaun@brightideagroup.com" class="hover:text-[#22427D] hover:underline transition-colors" data-ps="src/components/home/Contact.astro:link-email">
              shaun@brightideagroup.com
            </a>
          </div>

          <!-- Phone -->
          <div class="flex items-center gap-3" data-ps="src/components/home/Contact.astro:item-phone">
            <div class="w-6 h-6 text-[#22427D] shrink-0" data-ps="src/components/home/Contact.astro:icon-phone">
              <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                <path d="M4.11902 3.34473H7.61902C7.80275 3.34474 7.93038 3.39945 8.03503 3.49805C8.12854 3.58614 8.20705 3.70059 8.2655 3.85156L8.31726 4.01465L8.9823 7.02832C9.01497 7.26011 9.00744 7.44511 8.97253 7.5918C8.94139 7.72276 8.8796 7.83104 8.78015 7.92578L8.77332 7.93164L6.25574 10.415L5.97644 10.6904L6.17664 11.0264C6.60337 11.7435 7.05685 12.416 7.53699 13.042C8.01981 13.6715 8.55599 14.2696 9.14441 14.8369C9.75779 15.4701 10.399 16.0453 11.0682 16.5605C11.7434 17.0804 12.4488 17.5353 13.1844 17.9248L13.5155 18.0996L13.7762 17.832L16.1815 15.3643L16.1913 15.3535C16.3309 15.2021 16.4775 15.111 16.6337 15.0645C16.7647 15.0256 16.8944 15.012 17.0253 15.0215L17.1571 15.0391L19.9774 15.6631C20.1431 15.7092 20.2749 15.7806 20.3817 15.875L20.4813 15.9775C20.5981 16.1186 20.6552 16.2764 20.6552 16.4707V19.8809C20.6552 20.1178 20.581 20.2895 20.4374 20.4316C20.2909 20.5766 20.1181 20.6494 19.8866 20.6494C18.0114 20.6494 16.0911 20.1991 14.1219 19.2842C12.1538 18.3698 10.3229 17.0691 8.62976 15.376C7.0427 13.7889 5.79967 12.0798 4.89539 10.249L4.71863 9.88086C3.80159 7.90938 3.35046 5.99008 3.35046 4.11914C3.35048 3.94128 3.39174 3.79881 3.47351 3.67773L3.56921 3.56348C3.71327 3.41863 3.88502 3.34473 4.11902 3.34473ZM4.06628 4.5752C4.09721 5.28818 4.20923 6.0365 4.39929 6.81836C4.59086 7.60639 4.89058 8.47618 5.2948 9.4248L5.58386 10.1035L6.1073 9.58301L8.12683 7.5752L8.32019 7.38281L8.26257 7.11621L7.69421 4.44922L7.60925 4.05371H4.04382L4.06628 4.5752ZM19.9462 16.377L19.5477 16.2949L17.0624 15.7803L16.7909 15.7246L16.5985 15.9248L14.6356 17.9824L14.1542 18.4863L14.787 18.7812C15.4818 19.1045 16.2353 19.3664 17.0448 19.5693C17.8555 19.7725 18.6477 19.8945 19.4208 19.9336L19.9462 19.96V16.377Z" fill="currentColor" stroke="currentColor"></path>
              </svg>
            </div>
            <a href="tel:+17276033334" class="hover:text-[#22427D] hover:underline transition-colors" data-ps="src/components/home/Contact.astro:link-phone">
              +1 (727) 603-3334
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Form -->
      <div data-ps="src/components/home/Contact.astro:right-col">
        <form id="contact-form" class="flex flex-col gap-5" data-ps="src/components/home/Contact.astro:form">
          <div class="flex flex-col gap-2" data-ps="src/components/home/Contact.astro:field-name">
            <label for="name" class="text-[16px] font-normal text-[#222222]" data-ps="src/components/home/Contact.astro:lknwai">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full bg-white border border-[#3AA6C4] rounded-[4px] px-4 py-3 text-[18px] text-[#222222] focus:outline-none focus:ring-2 focus:ring-[#3AA6C4]"
            />
          </div>

          <div class="flex flex-col gap-2" data-ps="src/components/home/Contact.astro:field-email">
            <label for="email" class="text-[16px] font-normal text-[#222222]" data-ps="src/components/home/Contact.astro:lknwaj">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full bg-white border border-[#3AA6C4] rounded-[4px] px-4 py-3 text-[18px] text-[#222222] focus:outline-none focus:ring-2 focus:ring-[#3AA6C4]"
            />
          </div>

          <div class="flex flex-col gap-2" data-ps="src/components/home/Contact.astro:field-phone">
            <label for="phone" class="text-[16px] font-normal text-[#222222]" data-ps="src/components/home/Contact.astro:lknwak">Best Contact Phone</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full bg-white border border-[#3AA6C4] rounded-[4px] px-4 py-3 text-[18px] text-[#222222] focus:outline-none focus:ring-2 focus:ring-[#3AA6C4]"
            />
          </div>

          <div class="flex flex-col gap-2" data-ps="src/components/home/Contact.astro:field-message">
            <label for="message" class="text-[16px] font-normal text-[#222222]" data-ps="src/components/home/Contact.astro:lknwal">Message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder="Type your message..."
              class="w-full bg-white border border-[#3AA6C4] rounded-[4px] px-4 py-3 text-[18px] text-[#222222] focus:outline-none focus:ring-2 focus:ring-[#3AA6C4]"
            ></textarea>
          </div>

          <div data-ps="src/components/home/Contact.astro:1ijz2c">
            <button
              type="submit"
              id="submit-btn"
              class="bg-[#22427D] hover:bg-[#1b3564] text-white text-[18px] font-normal px-8 py-3 rounded-[4px] transition-colors cursor-pointer shadow-sm"
              data-ps="src/components/home/Contact.astro:btn-submit"
            >
              Submit
            </button>
          </div>

          <!-- Form status messages -->
          <div id="form-success" class="hidden p-4 rounded-[4px] bg-[#ECFDF3] border border-[#027A48] text-[#027A48] text-[16px]" data-ps="src/components/home/Contact.astro:1ijz2d">
            Thank you! Your submission has been received!
          </div>
          <div id="form-error" class="hidden p-4 rounded-[4px] bg-[#FEF3F2] border border-[#B42318] text-[#B42318] text-[16px]" data-ps="src/components/home/Contact.astro:1ijz2e">
            Oops! Something went wrong while submitting the form.
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('contact-form');
  const successBox = document.getElementById('form-success');
  const errorBox = document.getElementById('form-error');
  const submitBtn = document.getElementById('submit-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    successBox?.classList.add('hidden');
    errorBox?.classList.add('hidden');
    if (submitBtn) submitBtn.disabled = true;

    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      email: formData.get('email'),
      phone: formData.get('phone'),
      message: formData.get('message')
    };

    try {
      const res = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
      });

      if (res.ok) {
        successBox?.classList.remove('hidden');
        form.reset();
      } else {
        errorBox?.classList.remove('hidden');
      }
    } catch {
      errorBox?.classList.remove('hidden');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>

            loading="lazy"
            class="w-full h-full object-cover"
            data-ps="src/components/home/Services.astro:img-7"
          />
        </div>
        <div class="p-6 sm:p-7 flex flex-col justify-between" data-ps="src/components/home/Services.astro:content-7">
          <div data-ps="src/components/home/Services.astro:text-7">
            <h3 class="leading-[33.6px] font-bold font-serif mb-3 text-[rgb(34,34,34)] text-[24px]" data-ps="src/components/home/Services.astro:title-7">
              Podcast Advertising
            </h3>
            <p class="text-[16px] leading-[26px] text-[#222222] mb-6" data-ps="src/components/home/Services.astro:p-7">
              In a world flooded with ads, few channels let you speak directly into the listener's ear -- literally. Podcasts provide a unique, trusted environment where attorneys can build authority, educate potential clients, and stay top-of-mind....
            </p>
          </div>
          <div class="text-right" data-ps="src/components/home/Services.astro:link-box-7">
            <a
              href="/service/podcast-advertising-for-law-firms"
              class="text-[#22427D] font-normal text-[16px] hover:underline inline-block"
              data-ps="src/components/home/Services.astro:link-7"
            >
              Learn more
            </a>
          </div>
        </div>
      </div>

      <!-- Card 8: Accident Reporting / Leads -->
      <div class="bg-white grid grid-cols-1 sm:grid-cols-2 rounded-none overflow-hidden shadow-sm hover:shadow-md transition-shadow" data-ps="src/components/home/Services.astro:card-8">
        <div class="relative h-[220px] sm:h-full min-h-[200px] overflow-hidden" data-ps="src/components/home/Services.astro:img-wrapper-8">

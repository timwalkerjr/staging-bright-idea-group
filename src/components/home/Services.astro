    </div>

    <!-- View All Button -->
    <div class="text-center mt-12" data-ps="src/components/home/Services.astro:view-all-container">
      <a
        href="/services"
        class="bg-[#22427D] hover:bg-[#1b3564] text-white text-[18px] font-normal px-8 py-3 rounded-[4px] inline-block transition-colors shadow-sm"

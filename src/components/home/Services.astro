            </a>
          </div>
        </div>
      </div>

      <!-- Card 6: TV / OTT Marketing -->
      <div class="bg-white grid grid-cols-1 sm:grid-cols-2 rounded-none overflow-hidden shadow-sm hover:shadow-md transition-shadow" data-ps="src/components/home/Services.astro:card-6">
        <div class="relative h-[220px] sm:h-full min-h-[200px] overflow-hidden" data-ps="src/components/home/Services.astro:img-wrapper-6">

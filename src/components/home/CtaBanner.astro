---
// Mid-page CTA Banner matching brightideagroup.com
---

<section id="cta-banner" class="relative bg-[#091325] text-white overflow-hidden">
  <!-- Background Video with Poster Fallback -->
  <div class="absolute inset-0 w-full h-full z-0 overflow-hidden">
    <video
      autoplay
      muted
      loop
      playsinline
      poster="/assets/images/hero-poster.webp"
      class="w-full h-full object-cover"
    >
      <source
        src="/assets/video/hero-lightbulbs.mp4"
        type="video/mp4"
      />
    </video>
    <!-- Scrim Overlay: rgba(0, 19, 53, 0.75) -->
    <div class="absolute inset-0 bg-[#001335]/75"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-[1440px] mx-auto px-6 py-24 flex flex-col items-center justify-center text-center gap-8">
    <h2 class="text-[30px] sm:text-[36px] md:text-[40px] leading-[1.3] font-bold font-serif text-white max-w-[800px]">
      Contact us today and we will illuminate the path to growth!
    </h2>
    <a
      href="/contact"
      class="bg-[#3AA6C4] hover:bg-[#318ca5] text-white text-[18px] font-normal px-8 py-3 rounded-[4px] transition-colors shadow-md"
    >
      Schedule a Consultation
    </a>
  </div>
</section>

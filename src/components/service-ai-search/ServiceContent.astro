      <div>
        <h2 class="text-[36px] leading-[50.4px] font-bold font-serif text-[rgb(34,34,34)] mb-6">Why Choose Our AI Optimization Service?</h2>

        <h3 class="text-[20px] font-bold font-serif text-[rgb(34,34,34)] mb-3">Legal Industry Expertise</h3>
        <p class="text-[18px] leading-[28.8px] font-normal font-sans text-[rgb(34,34,34)] mb-6">

---
---
<section id="contact" class="bg-[rgba(201,210,217,0.45)] py-20">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 max-w-[1440px] mx-auto px-6">
    <div>
      <h2 class="text-[36px] leading-[50.4px] font-bold font-serif text-[rgb(34,34,34)] mb-6">Contact us</h2>
      <p class="text-[18px] leading-[28.8px] font-normal font-sans text-[rgb(34,34,34)] mb-8">
        We are available most days during normal business hours to consult with you and determine how we might best help your firm. Reach out to us using the form or the contact information below.
      </p>
      <ul class="space-y-4">
        <li class="flex items-center gap-3">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="rgb(34, 66, 125)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-10 5L2 7"></path>
          </svg>
          <a href="mailto:shaun@brightideagroup.com" class="text-[18px] font-normal font-sans text-[rgb(34,34,34)] hover:text-[rgb(34,66,125)] transition-colors">shaun@brightideagroup.com</a>
        </li>
        <li class="flex items-center gap-3">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="rgb(34, 66, 125)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <a href="tel:+17276033334" class="text-[18px] font-normal font-sans text-[rgb(34,34,34)] hover:text-[rgb(34,66,125)] transition-colors">+1 (727) 603-3334</a>
        </li>
      </ul>
    </div>
    <div>
      <form class="space-y-4" data-contact-form>
        <div>
          <label for="ar-name" class="block text-[16px] font-normal font-sans text-[rgb(34,34,34)] mb-2">Name</label>
          <input type="text" id="ar-name" name="name" required class="w-full bg-white border border-[rgb(58,166,196)] rounded-[4px] px-4 py-3 text-[18px] text-[rgb(0,0,0)] focus:outline-none focus:ring-2 focus:ring-[rgb(58,166,196)]" />
        </div>
        <div>
          <label for="ar-email" class="block text-[16px] font-normal font-sans text-[rgb(34,34,34)] mb-2">Email</label>
          <input type="email" id="ar-email" name="email" required class="w-full bg-white border border-[rgb(58,166,196)] rounded-[4px] px-4 py-3 text-[18px] text-[rgb(0,0,0)] focus:outline-none focus:ring-2 focus:ring-[rgb(58,166,196)]" />
        </div>
        <div>
          <label for="ar-phone" class="block text-[16px] font-normal font-sans text-[rgb(34,34,34)] mb-2">Best Contact Phone</label>
          <input type="tel" id="ar-phone" name="phone" class="w-full bg-white border border-[rgb(58,166,196)] rounded-[4px] px-4 py-3 text-[18px] text-[rgb(0,0,0)] focus:outline-none focus:ring-2 focus:ring-[rgb(58,166,196)]" />
        </div>
        <div>
          <label for="ar-message" class="block text-[16px] font-normal font-sans text-[rgb(34,34,34)] mb-2">Message</label>
          <textarea id="ar-message" name="message" rows="6" placeholder="Type your message..." class="w-full bg-white border border-[rgb(58,166,196)] rounded-[4px] px-4 py-3 text-[18px] text-[rgb(0,0,0)] focus:outline-none focus:ring-2 focus:ring-[rgb(58,166,196)]"></textarea>
        </div>
        <button type="submit" class="bg-[rgb(34,66,125)] text-white border border-black/20 rounded-[4px] px-8 py-3 text-[18px] font-normal hover:bg-[rgb(26,51,97)] transition-colors mt-2">Submit</button>
        <div class="success-message hidden p-4 bg-green-100 border border-green-400 text-green-700 rounded-[4px] mt-4">Thank you! Your submission has been received!</div>
        <div class="error-message hidden p-4 bg-red-100 border border-red-400 text-red-700 rounded-[4px] mt-4">Oops! Something went wrong while submitting the form.</div>
      </form>
    </div>
  </div>
</section>

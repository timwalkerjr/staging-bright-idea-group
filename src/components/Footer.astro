---
// Footer matching brightideagroup.com
---

<footer class="bg-[#091325] text-white" data-ps="src/components/Footer.astro:footer">
  <div class="max-w-[1440px] mx-auto px-6 py-10" data-ps="src/components/Footer.astro:container">
    <!-- Top Row: Logo & Navigation Links -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8" data-ps="src/components/Footer.astro:top-wrapper">
      <a href="/" class="inline-flex items-center" data-ps="src/components/Footer.astro:logo-link">
        <img
          src="https://pagesmith-cdn.com/06cfb84b/images/68e9ad149fb2838ec812420a_LOGO-v6-final-LIGHT-640.webp"
          alt="Bright Idea Group"
          class="h-[44px] w-auto object-contain"
          data-ps="src/components/Footer.astro:logo-img"
        />
      </a>

      <nav class="flex flex-wrap items-center justify-center gap-6 sm:gap-8" data-ps="src/components/Footer.astro:nav-links">
        <a href="/" class="text-white text-[16px] font-light hover:text-[#3AA6C4] transition-colors" data-ps="src/components/Footer.astro:link-home">Home</a>
        <a href="/services" class="text-white text-[16px] font-light hover:text-[#3AA6C4] transition-colors" data-ps="src/components/Footer.astro:link-services">Services</a>
        <a href="/team" class="text-white text-[16px] font-light hover:text-[#3AA6C4] transition-colors" data-ps="src/components/Footer.astro:link-team">Team</a>
        <a href="/contact" class="text-white text-[16px] font-light hover:text-[#3AA6C4] transition-colors" data-ps="src/components/Footer.astro:link-contact">Contact</a>
        <a href="/contact" class="text-white text-[16px] font-light hover:text-[#3AA6C4] transition-colors" data-ps="src/components/Footer.astro:link-schedule">Schedule a Call</a>
      </nav>
    </div>

    <!-- Bottom Row: Copyright -->
    <div class="border-t border-white/10 pt-6 text-center text-white/70 text-[14px]" data-ps="src/components/Footer.astro:bottom-wrapper">
      <p data-ps="src/components/Footer.astro:copyright">© 2025 Bright Idea Group. All rights reserved.</p>
    </div>
  </div>
</footer>

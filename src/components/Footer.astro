---
// Footer matching brightideagroup.com
---

<footer class="bg-[#091325] text-white">
  <div class="max-w-[1440px] mx-auto px-6 py-10">
    <!-- Top Row: Logo & Navigation Links -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8">
      <a href="/" class="inline-flex items-center">
        <img
          src="/assets/images/logo-light.webp"
          alt="Bright Idea Group"
          class="h-[44px] w-auto object-contain"
        />
      </a>

      <nav class="flex flex-wrap items-center justify-center gap-6 sm:gap-8">
        <a href="/" class="text-white text-[16px] font-light hover:text-[#3AA6C4] transition-colors">Home</a>
        <a href="/services" class="text-white text-[16px] font-light hover:text-[#3AA6C4] transition-colors">Services</a>
        <a href="/team" class="text-white text-[16px] font-light hover:text-[#3AA6C4] transition-colors">Team</a>
        <a href="/contact" class="text-white text-[16px] font-light hover:text-[#3AA6C4] transition-colors">Contact</a>
        <a href="/contact" class="text-white text-[16px] font-light hover:text-[#3AA6C4] transition-colors">Schedule a Call</a>
      </nav>
    </div>

    <!-- Bottom Row: Copyright -->
    <div class="border-t border-white/10 pt-6 text-center text-white/70 text-[14px]">
      <p>© 2025 Bright Idea Group. All rights reserved.</p>
    </div>
  </div>
</footer>

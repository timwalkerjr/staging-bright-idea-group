---
// Navigation matching brightideagroup.com exactly
---

<header id="navbar" class="relative z-40 bg-white border-b border-black/5" data-ps="src/components/Navigation.astro:header">
  <div class="max-w-[1440px] mx-auto px-6 py-4 flex items-center justify-between" data-ps="src/components/Navigation.astro:nav-container">
    <!-- Logo -->
    <a href="/" class="inline-flex items-center" data-ps="src/components/Navigation.astro:logo-link">
      <img
        src="https://pagesmith-cdn.com/06cfb84b/images/68e9ad149fb2838ec8124209_LOGO-v6-final-640.webp"
        alt="Bright Idea Group"
        class="h-[44px] sm:h-[48px] w-auto object-contain"
        data-ps="src/components/Navigation.astro:logo-img"
      />
    </a>

    <!-- Desktop Navigation Links & Action Buttons -->
    <div class="hidden lg:flex items-center gap-8" data-ps="src/components/Navigation.astro:desktop-nav">
      <nav class="flex items-center gap-8" data-ps="src/components/Navigation.astro:links-row">
        <a href="/" class="text-[18px] text-[#222222] font-normal hover:text-[#22427D] transition-colors" data-ps="src/components/Navigation.astro:link-home">Home</a>
        <a href="/services" class="text-[18px] text-[#222222] font-normal hover:text-[#22427D] transition-colors" data-ps="src/components/Navigation.astro:link-services">Services</a>
        <a href="/team" class="text-[18px] text-[#222222] font-normal hover:text-[#22427D] transition-colors" data-ps="src/components/Navigation.astro:link-team">Team</a>
        <a href="/contact" class="text-[18px] text-[#222222] font-normal hover:text-[#22427D] transition-colors" data-ps="src/components/Navigation.astro:link-contact">Contact</a>
      </nav>

      <div class="flex items-center gap-3" data-ps="src/components/Navigation.astro:nav-actions">
        <a
          href="tel:+17276033334"
          class="bg-[#3AA6C4] hover:bg-[#318ca5] text-white text-[16px] font-normal px-5 py-2.5 rounded-[4px] transition-colors whitespace-nowrap shadow-sm"
          data-ps="src/components/Navigation.astro:btn-phone"
        >
          (727) 603-3334
        </a>
        <a
          href="/contact"
          class="bg-[#22427D] hover:bg-[#1b3564] text-white text-[16px] font-normal px-5 py-2.5 rounded-[4px] transition-colors whitespace-nowrap shadow-sm"
          data-ps="src/components/Navigation.astro:btn-schedule"
        >
          Schedule a Call
        </a>
      </div>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-button"
      type="button"
      class="lg:hidden p-2 text-[#222222] hover:text-[#22427D] transition-colors"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-ps="src/components/Navigation.astro:mobile-button"
    >
      <svg id="menu-icon-open" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden bg-white border-t border-black/10 px-6 py-5 shadow-lg"
    role="navigation"
    aria-label="Mobile navigation"
    data-ps="src/components/Navigation.astro:mobile-menu"
  >
    <nav class="flex flex-col gap-4 mb-6" data-ps="src/components/Navigation.astro:mobile-links">
      <a href="/" class="text-[18px] text-[#222222] font-normal hover:text-[#22427D] py-1 transition-colors" data-ps="src/components/Navigation.astro:m-link-home">Home</a>
      <a href="/services" class="text-[18px] text-[#222222] font-normal hover:text-[#22427D] py-1 transition-colors" data-ps="src/components/Navigation.astro:m-link-services">Services</a>
      <a href="/team" class="text-[18px] text-[#222222] font-normal hover:text-[#22427D] py-1 transition-colors" data-ps="src/components/Navigation.astro:m-link-team">Team</a>
      <a href="/contact" class="text-[18px] text-[#222222] font-normal hover:text-[#22427D] py-1 transition-colors" data-ps="src/components/Navigation.astro:m-link-contact">Contact</a>
    </nav>
    <div class="flex flex-col gap-3" data-ps="src/components/Navigation.astro:m-actions">
      <a
        href="tel:+17276033334"
        class="bg-[#3AA6C4] hover:bg-[#318ca5] text-white text-[16px] font-normal text-center py-3 rounded-[4px] transition-colors"
        data-ps="src/components/Navigation.astro:m-btn-phone"
      >
        (727) 603-3334
      </a>
      <a
        href="/contact"
        class="bg-[#22427D] hover:bg-[#1b3564] text-white text-[16px] font-normal text-center py-3 rounded-[4px] transition-colors"
        data-ps="src/components/Navigation.astro:m-btn-schedule"
      >
        Schedule a Call
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  function toggleMenu() {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    } else {
      mobileMenu?.classList.remove('hidden');
      menuIconOpen?.classList.add('hidden');
      menuIconClose?.classList.remove('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'true');
    }
  }

  mobileMenuButton?.addEventListener('click', toggleMenu);
</script>
